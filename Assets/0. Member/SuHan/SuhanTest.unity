--- !u!114 &1668914646
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1668914644}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7bbc75972835ad442a88bab138b48a00, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  text: "\uAC00\uAE4C\uC6B4 \uC55E\uC904: \uBC1C\uC804\uAE30 3\uB300 (\uBC84\uD2BC
    \uD074\uB9AD \u2192 3\uCD08, 1\uB300 \uACE0\uCE58\uBA74 \uB2E4\uC74C 1\uB300\uAE4C\uC9C0
    2\uBD84)\n\uBA3C \uC55E\uC904: \uB2E8\uCCB4 \uBBF8\uC158 \u2014 \uCF54\uB4DC
    \xB7 \uC7A5\uBE44 \uC870\uB9BD \xB7 \uC0DD\uBA85 \uC720\uC9C0 \uC7A5\uCE58 \xB7
    \uBC29\uD654\uBB38 (\uBAA8\uB450 \uC2E4\uC81C)  /  \uB4A4: \uAC1C\uC778 \uBBF8\uC158
    6\uC885 \u2014 \uBAA8\uB450 \uC2E4\uC81C \uBBF8\uB2C8\uAC8C\uC784\n\uBC29\uD654\uBB38(\uBA3C
    \uC55E\uC904 \uC624\uB978\uCABD): \uB2E4\uB978 \uB2E8\uCCB4 \uBBF8\uC158 \uC644\uB8CC
    \u2192 \uB808\uBC84 2\uAC1C \uD328\uB110\uC5D0 \uB07C\uC6B0\uAE30(\uC6B0\uD074\uB9AD)
    \u2192 30\uCD08 \uC548\uC5D0 \uB0B4\uB9AC\uAE30(\uD074\uB9AD)   F8 = \uBC29\uD654\uBB38
    \uBE7C\uACE0 \uB2E8\uCCB4 \uBBF8\uC158 \uC989\uC2DC \uC644\uB8CC(\uD14C\uC2A4\uD2B8)\n\uC7A5\uBE44
    \uC870\uB9BD(\uBA3C \uC55E\uC904 \uC67C\uCABD): \uBD80\uD488 4\uAC1C(1\uAC1C\uB294
    \uC7A5\uBE44 \uC8FC\uBCC0)\uB97C \uCC3E\uC544 \uB4E4\uACE0 \uC7A5\uBE44 \uC55E
    \uBC14\uB2E5 \uC6D0 \uC548\uC73C\uB85C \u2192 \uC790\uB3D9\uC73C\uB85C \uBD99\uC74C\n\uC0DD\uBA85
    \uC720\uC9C0 \uC7A5\uCE58(\uBA3C \uC55E\uC904): \uC0B0\uC18C\uD1B5 6\uAC1C \uC911
    \uC815\uC0C1 3\uAC1C\uB9CC \uBCF8\uCCB4\uC5D0 \u2014 \uAC00\uAE4C\uC774\uC11C
    \uC555\uB825\uACC4 \uD655\uC778 \u2192 \uB4E4\uAE30(\uC88C\uD074\uB9AD) \u2192
    \uBCF8\uCCB4\uC5D0 \uC6B0\uD074\uB9AD, \uCCAB \uACF5\uAE09\uBD80\uD130 120\uCD08\nShift
    \uB2EC\uB9AC\uAE30 = AG101 '\uB6F0\uC9C0 \uC54A\uB294\uB2E4' \uC704\uBC18   F9
    \uB0B4 \uD589\uB3D9 \uD655\uC815 / F10 \uC804\uCCB4 \uACF5\uAC1C"
  color: {r: 1, g: 1, b: 1, a: 1}
  tintRenderers: 0
  heightOffset: 0.4
